# Copy to .env and fill in. Never commit .env.
# Passphrase shared by the app and the iPhone Shortcut (sent as the x-app-key header).
APP_KEY=
# For the morning coach, ask the coach and the journal.
ANTHROPIC_API_KEY=
# Optional: read-only gym app backup. Placeholder: https://your-gym-app.example.com/api/backup
GYM_API_URL=
GYM_BACKUP_KEY=
# Optional: intervals.icu wellness (HRV and sleep from Zepp).
INTERVALS_ATHLETE_ID=
INTERVALS_API_KEY=
# Added by Vercel when a Blob store is connected. Leave empty locally to use tmp/store.
BLOB_READ_WRITE_TOKEN=
